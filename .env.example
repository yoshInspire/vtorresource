# Скопируйте в .env и заполните. Файл .env в git не попадает.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
SITE_URL=https://mbaza55.ru

# Админка прайс-листа: /admin
# Без ADMIN_PASSWORD роутер не подключается и /admin отдаёт 404.
ADMIN_PASSWORD=
# Секрет для подписи сессионной куки и CSRF-токенов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
