<%- include('partials/head') %>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<%#
  Общий шаблон каталогов: радиодетали и драгметаллы. Раскладка та же, что
  на основном прайсе, — слева нумерованный список позиций с поиском наверху,
  справа липкий список разделов. Разделы приходят из catalogs.sections():
  у радиодеталей это категории, у драгметаллов группы, см. REGISTRY.
%>

<main id="main" class="price-page">

  <section class="page-head page-head--tight">
    <div class="container">
      <h1 class="page-head__title"><%= h1 %></h1>
    </div>
  </section>

  <div class="container">
    <div class="price-layout">

      <div class="price-main">
        <div class="price-bar">
          <label class="price-search">
            <svg aria-hidden="true"><use href="#i-search"></use></svg>
            <input class="price-search__input" type="search" placeholder="Название позиции"
                   autocomplete="off" aria-label="Поиск по прайсу" data-price-search>
          </label>
          <span class="badge badge--live">Обновлено <%= f.dateLong(catalog.updatedAt) %></span>
        </div>

        <p class="price-empty" hidden data-price-empty>
          Такой позиции в прайсе нет. Позвоните, оценим по описанию:
          <% site.phones.forEach(function (p, i) { %><a class="link" href="tel:<%= p.raw %>"><%= p.display %></a><%= i < site.phones.length - 1 ? ' или ' : '.' %><% }); %>
        </p>

        <% sections.forEach(function (block) { %>
          <%
            // Разъёмов полторы сотни в одном разделе: в столбик это семь
            // экранов подряд. Такой раздел режем на две таблицы рядом,
            // у каждой своя шапка, порядок позиций не меняется.
            var wide = block.items.length > f.LONG_TABLE;
            var parts = wide ? f.chunk(block.items, 2) : [block.items];
          %>
          <section class="price-cat" id="<%= block.id %>" data-price-cat>
            <h2 class="price-cat__title"><%= block.title %></h2>

            <div class="<%= wide ? 'price-split' : '' %>">
              <% parts.forEach(function (rows) { %>
                <table class="price-table price-table--flat">
                  <caption class="visually-hidden"><%= block.title %>, цены приёма</caption>
                  <thead>
                    <tr>
                      <th class="price-table__num" aria-hidden="true"></th>
                      <th scope="col">Позиция</th>
                      <th scope="col" class="price-table__unit">Ед.</th>
                      <th scope="col" class="price-table__col"><%= block.columns ? block.columns[0] : 'Цена, ₽' %></th>
                      <% if (block.columns && block.columns[1]) { %>
                        <th scope="col" class="price-table__col"><%= block.columns[1] %></th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% rows.forEach(function (item) { %>
                      <tr data-price-row data-search="<%= (item.title + ' ' + (item.note || '') + ' ' + block.title).toLowerCase() %>">
                        <td class="price-table__num" aria-hidden="true"></td>
                        <th scope="row" class="price-table__name">
                          <%# Описание раскрывается по клику: <details> работает без JS,
                              открывается с клавиатуры и остаётся в разметке для поиска. %>
                          <% if (item.note) { %>
                            <details class="price-note">
                              <summary><%= item.title %></summary>
                              <p><%= item.note %></p>
                            </details>
                          <% } else { %>
                            <%= item.title %>
                          <% } %>
                        </th>
                        <td class="price-table__unit"><%= item.unit %></td>
                        <td class="price-table__value"><b><%= cat.formatPrice(item.price) %></b></td>
                        <% if (block.columns && block.columns[1]) { %>
                          <td class="price-table__value price-table__value--alt">
                            <%= item.priceBulk ? cat.formatPrice(item.priceBulk) : '—' %>
                          </td>
                        <% } %>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% }); %>
            </div>
          </section>
        <% }); %>
      </div>

      <aside class="price-nav" aria-label="Разделы прайса">
        <p class="price-nav__title">Разделы</p>
        <div class="price-nav__list">
          <% sections.forEach(function (block) { %>
            <a class="price-nav__link" href="#<%= block.id %>"
               data-nav-for="<%= block.id %>"><%= block.title %></a>
          <% }); %>
        </div>
      </aside>

    </div>
  </div>

  <section class="section section--dark" id="zayavka-form">
    <div class="container price-cta">
      <div class="price-cta__text">
        <h2 class="section__title">Оценим по описанию</h2>
        <p><%= catalog.note %></p>
        <p>
          Приём ведётся на площадке в Омске по адресу <%= site.address.full %>,
          <%= site.hours.text.toLowerCase() %>. Звоните:
          <% site.phones.forEach(function (p, i) { %><a class="link" href="tel:<%= p.raw %>"><%= p.display %></a><%= i < site.phones.length - 1 ? ', ' : '' %><% }); %>.
        </p>
      </div>
      <div class="price-cta__form">
        <% if (leadStatus === 'ok') { %>
          <div class="alert alert--ok" role="status"><strong>Заявка принята.</strong> Скоро перезвоним.</div>
        <% } %>
        <%- include('partials/lead-form', {
          variant: 'dark',
          formTitle: 'Уточнить цену',
          formText: 'Оставьте номер и опишите, что у вас есть. Перезвоним и назовём цену.'
        }) %>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container container--narrow">
      <h2 class="section__title"><%= aboutTitle %></h2>
      <div class="prose">
        <%# Лид страницы и описания групп живут здесь: наверху они отодвигали
            таблицы, но в них перечислены виды лома под поиск. %>
        <p><%= lead %></p>
        <ul class="prose__list">
          <% catalog.groups.forEach(function (g) { %>
            <li><b><%= g.title %>.</b> <%= g.description %></li>
          <% }); %>
        </ul>
        <% about.forEach(function (para) { %>
          <p><%- para %></p>
        <% }); %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
