<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__col footer__col--brand">
      <a class="logo logo--footer" href="/">
        <img class="logo__mark" src="<%= asset('/img/logo.png') %>" width="208" height="138" alt="">
        <span class="logo__text">
          <span class="logo__name"><%= site.brand %></span>
          <span class="logo__sub">приём лома <%= site.cityIn %></span>
        </span>
      </a>
      <p class="footer__about">
        Пункт приёма чёрного, цветного и редкоземельного лома в Омске.
        Принимаем на площадке по адресу <%= site.address.full %>.
      </p>
    </div>

    <nav class="footer__col" aria-label="Разделы сайта">
      <p class="footer__title">Разделы</p>
      <a class="footer__link" href="/#priem">Что принимаем</a>
      <a class="footer__link" href="/#kalkulyator">Калькулятор</a>
      <a class="footer__link" href="/price">Прайс-лист</a>
      <a class="footer__link" href="/#kak-rabotaem">Как сдать</a>
      <a class="footer__link" href="/#zasor">Про засор</a>
      <a class="footer__link" href="/#punkt-priema">Площадка</a>
      <a class="footer__link" href="/#blagodarnosti">Благодарности</a>
      <a class="footer__link" href="/#yurlicam">Организациям</a>
    </nav>

    <div class="footer__col">
      <p class="footer__title">Приём лома</p>
      <a class="footer__link" href="/price#med">Медь</a>
      <a class="footer__link" href="/price#latun-bronza">Латунь и бронза</a>
      <a class="footer__link" href="/price#alyuminiy">Алюминий</a>
      <a class="footer__link" href="/price#svinec">Свинец</a>
      <a class="footer__link" href="/price#nerzhaveyuschaya-i-nizkolegirovannaya-stal">Нержавейка</a>
      <a class="footer__link" href="/price#akkumulyatory">Аккумуляторы</a>
      <a class="footer__link" href="/price#stal-chugun">Чёрный металл</a>
      <a class="footer__link" href="/price#tverdye-splavy-pobedit">Твёрдые сплавы</a>
    </div>

    <div class="footer__col">
      <p class="footer__title">Контакты</p>
      <div class="footer__phones">
        <% site.phones.forEach(function (p) { %>
          <span class="footer__phone-row">
            <a class="footer__link footer__link--phone" href="tel:<%= p.raw %>"><%= p.display %></a>
            <%- include('messengers', { phone: p, size: 'sm' }) %>
          </span>
        <% }); %>
      </div>
      <p class="footer__line"><%= site.address.full %></p>
      <p class="footer__line"><%= site.hours.text %></p>
      <a class="footer__link" href="mailto:<%= site.email %>"><%= site.email %></a>
      <a class="footer__link" href="<%= site.profiles.twogis %>" target="_blank" rel="noopener">Мы в 2ГИС</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© <%= new Date().getFullYear() %> <%= site.legalName %>. Приём чёрного, цветного и редкоземельного лома в Омске.</p>
    <p class="footer__disclaimer">
      Информация на сайте носит справочный характер и не является публичной офертой.
      <a href="/privacy">Политика обработки персональных данных</a>.
    </p>
    <p class="footer__req">
      ОГРН <%= site.legal.ogrn %> · ИНН <%= site.legal.inn %> · КПП <%= site.legal.kpp %>.
      Юридический адрес: <%= site.legal.address %>.
      Приём лома ведётся по адресу <%= site.address.full %>.
    </p>

    <% if (photoCredits && photoCredits.length) { %>
      <%
        // Один автор мог снять несколько кадров — в подписи он должен быть один раз
        var _seen = {};
        var _authors = photoCredits.filter(function (c) {
          var key = c.author + c.license;
          if (_seen[key]) return false;
          _seen[key] = true;
          return true;
        });
      %>
      <p class="footer__credits">
        Фотографии: Wikimedia Commons,
        <% _authors.forEach(function (c, i) { %><a href="<%= c.source %>" target="_blank" rel="noopener nofollow"><%= c.author %></a> (<%= c.license %>)<%= i < _authors.length - 1 ? ', ' : '.' %><% }); %>
      </p>
    <% } %>
  </div>
</footer>

<a class="call-fab" href="tel:<%= site.phonePrimary.raw %>" aria-label="Позвонить">
  <svg aria-hidden="true"><use href="#i-phone"></use></svg>
</a>

<script src="<%= asset('/js/main.js') %>" defer></script>
</body>
</html>
