<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta name="theme-color" content="<%= site.themeColor %>">
<meta name="format-detection" content="telephone=no">
<meta name="geo.region" content="RU-OMS">
<meta name="geo.placename" content="<%= site.city %>">

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.brand %>">
<meta property="og:locale" content="<%= site.locale %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
<meta property="og:image" content="<%= site.url + site.seo.ogImage %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Вторресурс — приём лома чёрных и цветных металлов в Омске">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" sizes="180x180">
<link rel="preload" href="/css/style.css" as="style">
<link rel="stylesheet" href="/css/style.css">
<link rel="preload" href="/fonts/oswald-600-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/golos-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<% if (jsonLd) { %>
<script type="application/ld+json"><%- f.jsonLd(jsonLd) %></script>
<% } %>
</head>
<body class="page page--<%= page %>">
<a class="skip-link" href="#main">Перейти к содержимому</a>
