<header class="header" id="top">
  <div class="header__top">
    <div class="container header__top-inner">
      <span class="header__top-item">
        <svg aria-hidden="true"><use href="#i-pin"></use></svg>
        <%= site.address.full %>
      </span>
      <span class="header__top-item">
        <svg aria-hidden="true"><use href="#i-clock"></use></svg>
        <%= site.hours.short %>
      </span>
      <a class="header__msg" href="<%= site.messengers.max %>" target="_blank" rel="noopener">
        <svg aria-hidden="true"><use href="#i-max"></use></svg>
        Написать в MAX
      </a>
    </div>
  </div>

  <div class="container header__inner">
    <a class="logo" href="/" aria-label="<%= site.brand %> — на главную">
      <img class="logo__mark" src="/img/logo.png" width="46" height="46" alt="">
      <span class="logo__text">
        <span class="logo__name"><%= site.brand %></span>
        <span class="logo__sub">приём лома <%= site.cityIn %></span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
    <label for="nav-toggle" class="burger" aria-label="Меню"><span></span></label>

    <nav class="nav" aria-label="Основная навигация">
      <a class="nav__link" href="/#priem">Что принимаем</a>
      <a class="nav__link" href="/#kalkulyator">Калькулятор</a>
      <a class="nav__link<%= currentPath === '/price' ? ' is-active' : '' %>" href="/price">Прайс-лист</a>
      <a class="nav__link" href="/#kak-rabotaem">Как сдать</a>
      <a class="nav__link" href="/#punkt-priema">Площадка</a>
      <a class="nav__link" href="/#kontakty">Контакты</a>

      <!-- Телефоны в выпадающем меню: в узкой шапке им места нет -->
      <div class="nav__phones">
        <% site.phones.forEach(function (p) { %>
          <span class="nav__phone-row">
            <a class="nav__phone" href="tel:<%= p.raw %>"><%= p.display %></a>
            <%- include('messengers', { phone: p, size: 'sm' }) %>
          </span>
        <% }); %>
        <span class="nav__hours"><%= site.hours.short %></span>
      </div>
    </nav>

    <div class="header__contact">
      <a class="header__phone" href="tel:<%= site.phonePrimary.raw %>"><%= site.phonePrimary.display %></a>
      <span class="header__hours"><%= site.terms.priceUpdate.toLowerCase() %></span>
    </div>

    <a class="btn btn--accent btn--sm header__cta" href="/#zayavka">Узнать цену</a>
  </div>
</header>
