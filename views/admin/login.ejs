<%- include('_head') %>

<main class="adm-login">
  <form class="adm-card adm-login__form" action="/admin/login" method="post">
    <img class="adm-login__logo" src="/img/logo.png" width="120" height="80" alt="">
    <h1 class="adm-login__title"><%= site.brand %></h1>
    <p class="adm-login__sub">Управление прайс-листом</p>

    <% if (error) { %>
      <p class="adm-alert adm-alert--err" role="alert"><%= error %></p>
    <% } %>

    <label class="adm-field">
      <span class="adm-field__label">Пароль</span>
      <input class="adm-field__input" type="password" name="password" required autofocus
             autocomplete="current-password">
    </label>

    <button class="adm-btn adm-btn--accent adm-btn--block" type="submit">Войти</button>
  </form>
</main>

<%- include('_foot') %>
