<%- include('_head') %>
<%- include('_nav') %>

<main class="adm-main">
  <div class="adm-head">
    <div>
      <h1 class="adm-h1"><%= meta.title %></h1>
      <p class="adm-sub">Обновлён <%= f.dateLong(catalog.updatedAt) %>.</p>
    </div>
    <a class="adm-btn adm-btn--ghost" href="<%= meta.url %>" target="_blank" rel="noopener">Посмотреть на сайте</a>
  </div>

  <%- include('_catalog-tabs') %>

  <% if (saved) { %>
    <p class="adm-alert adm-alert--ok" role="status">Сохранено</p>
  <% } %>

  <% if (added) { %>
    <p class="adm-alert adm-alert--ok" role="status">
      <%= added === 'category' ? 'Категория добавлена' : 'Позиция добавлена' %>
    </p>
  <% } %>

  <% if (removed) { %>
    <p class="adm-alert adm-alert--ok" role="status">
      <%= removed === 'category' ? 'Категория удалена' : 'Позиция удалена' %>
    </p>
  <% } %>

  <% if (error) { %>
    <p class="adm-alert adm-alert--err" role="alert">
      <% if (error === 'csrf') { %>
        Форма устарела: вход был выполнен слишком давно. Откройте страницу заново и повторите.
      <% } else if (error === 'title') { %>
        Не добавил позицию: у неё должно быть название.
      <% } else if (error === 'catname') { %>
        Не добавил категорию: у неё должно быть название.
      <% } else { %>
        Не нашёл, что вы правите. Возможно, это уже удалили в другой вкладке.
      <% } %>
    </p>
  <% } %>

  <div class="adm-tabs">
    <% catalog.groups.forEach(function (g) { %>
      <a class="adm-tab<%= g.id === group.id ? ' is-active' : '' %>"
         href="/admin/catalog/<%= catalogName %>?group=<%= g.id %>">
        <%= g.title %>
        <span><%= g.categories.reduce(function (a, c) { return a + c.items.length; }, 0) %></span>
      </a>
    <% }); %>
  </div>

  <!-- Формы удаления вынесены из таблицы: вложенные формы недопустимы. -->
  <form id="del-form" action="/admin/catalog/<%= catalogName %>/delete" method="post" hidden>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="group" value="<%= group.id %>">
  </form>
  <form id="del-cat-form" action="/admin/catalog/<%= catalogName %>/category/delete" method="post" hidden>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="group" value="<%= group.id %>">
  </form>

  <form action="/admin/catalog/<%= catalogName %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="group" value="<%= group.id %>">

    <%# Enter в поле отправляет форму первой кнопкой submit: без этой скрытой
        кнопки он двигал бы первую категорию. %>
    <button class="visually-hidden" type="submit" tabindex="-1">Сохранить</button>

    <% group.categories.forEach(function (category, ci) { %>
      <section class="adm-cat" id="<%= category.id %>">
        <div class="adm-cat__head">
          <h2 class="adm-cat__title">
            <input class="adm-input adm-cat__name" type="text" maxlength="120" required
                   name="catname__<%= category.id %>"
                   value="<%= category.name %>"
                   aria-label="Название категории">
          </h2>
          <span class="adm-cat__tools">
            <span class="adm-cat__count"><%= category.items.length %></span>
            <button class="adm-move" type="submit" name="catmove" value="up__<%= category.id %>"
                    title="Категорию выше" <%= ci === 0 ? 'disabled' : '' %>>
              ↑<span class="visually-hidden"> категорию <%= category.name %> выше</span>
            </button>
            <button class="adm-move" type="submit" name="catmove" value="down__<%= category.id %>"
                    title="Категорию ниже"
                    <%= ci === group.categories.length - 1 ? 'disabled' : '' %>>
              ↓<span class="visually-hidden"> категорию <%= category.name %> ниже</span>
            </button>
            <button class="adm-del" type="submit" form="del-cat-form"
                    name="category" value="<%= category.id %>">
              Удалить категорию<span class="visually-hidden"> <%= category.name %></span>
            </button>
          </span>
        </div>

        <div class="adm-tablewrap">
          <table class="adm-table">
            <thead>
              <tr>
                <th scope="col">Название и уточнение</th>
                <th scope="col" class="adm-table__unit">Ед.</th>
                <th scope="col" class="adm-table__num"><%= (group.columns && group.columns[0]) || 'Цена' %></th>
                <% if (group.columns && group.columns[1]) { %>
                  <th scope="col" class="adm-table__num"><%= group.columns[1] %></th>
                <% } %>
                <th scope="col" class="adm-table__cat">Категория</th>
                <th scope="col" class="adm-table__act"><span class="visually-hidden">Действия</span></th>
              </tr>
            </thead>
            <tbody>
              <% category.items.forEach(function (item, ii) { %>
                <tr>
                  <td class="adm-table__name">
                    <input class="adm-input adm-input--title" type="text" maxlength="400" required
                           name="title__<%= category.id %>__<%= item.id %>"
                           value="<%= item.title %>"
                           aria-label="Название позиции">
                    <input class="adm-input adm-input--note" type="text" maxlength="400"
                           name="note__<%= category.id %>__<%= item.id %>"
                           value="<%= item.note || '' %>"
                           placeholder="уточнение: требования, состояние"
                           aria-label="Уточнение к позиции <%= item.title %>">
                  </td>
                  <td>
                    <input class="adm-input adm-input--unit" type="text" maxlength="24"
                           name="unit__<%= category.id %>__<%= item.id %>"
                           value="<%= item.unit || '' %>"
                           placeholder="1 кг"
                           aria-label="Единица измерения: <%= item.title %>">
                  </td>
                  <td>
                    <input class="adm-input adm-input--num" type="text" maxlength="60"
                           name="price__<%= category.id %>__<%= item.id %>"
                           value="<%= item.price || '' %>"
                           aria-label="Цена: <%= item.title %>">
                  </td>
                  <% if (group.columns && group.columns[1]) { %>
                    <td>
                      <input class="adm-input adm-input--num" type="text" maxlength="60"
                             name="priceBulk__<%= category.id %>__<%= item.id %>"
                             value="<%= item.priceBulk || '' %>"
                             aria-label="<%= group.columns[1] %>: <%= item.title %>">
                    </td>
                  <% } %>
                  <%# Перенос в другую категорию той же группы: у групп каталога
                      разные колонки цен, и позиция из «Плат» в «Радиодеталях»
                      осталась бы без второй цены. %>
                  <td class="adm-table__cat">
                    <select class="adm-input adm-input--cat"
                            name="catof__<%= category.id %>__<%= item.id %>"
                            aria-label="Категория позиции <%= item.title %>">
                      <% group.categories.forEach(function (c) { %>
                        <option value="<%= c.id %>"<%= c.id === category.id ? ' selected' : '' %>>
                          <%= c.name %>
                        </option>
                      <% }); %>
                    </select>
                  </td>
                  <td class="adm-table__act">
                    <span class="adm-rowtools">
                      <button class="adm-move" type="submit"
                              name="move" value="up__<%= category.id %>__<%= item.id %>"
                              title="Выше" <%= ii === 0 ? 'disabled' : '' %>>
                        ↑<span class="visually-hidden"> позицию <%= item.title %> выше</span>
                      </button>
                      <button class="adm-move" type="submit"
                              name="move" value="down__<%= category.id %>__<%= item.id %>"
                              title="Ниже" <%= ii === category.items.length - 1 ? 'disabled' : '' %>>
                        ↓<span class="visually-hidden"> позицию <%= item.title %> ниже</span>
                      </button>
                      <button class="adm-del" type="submit" form="del-form"
                              name="item" value="<%= category.id %>__<%= item.id %>"
                              title="Удалить позицию">
                        Удалить<span class="visually-hidden"> позицию <%= item.title %></span>
                      </button>
                    </span>
                  </td>
                </tr>
              <% }); %>
              <% if (!category.items.length) { %>
                <tr>
                  <td colspan="<%= group.columns && group.columns[1] ? 6 : 5 %>" class="adm-table__empty">
                    Пока пусто. Добавьте позицию внизу страницы, выбрав эту категорию.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    <% }); %>

    <div class="adm-save">
      <button class="adm-btn adm-btn--accent" type="submit">Сохранить</button>
      <span class="adm-save__hint">
        Одной кнопкой сохраняются цены, названия, категории и порядок.
      </span>
    </div>
  </form>

  <section class="adm-add">
    <h2 class="adm-add__title">Добавить позицию</h2>
    <form class="adm-add__form" action="/admin/catalog/<%= catalogName %>/add" method="post">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="group" value="<%= group.id %>">

      <label class="adm-field adm-add__cat">
        <span class="adm-field__label">Категория</span>
        <select class="adm-field__input" name="category" required>
          <% group.categories.forEach(function (c) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }); %>
        </select>
      </label>

      <label class="adm-field adm-add__title-field">
        <span class="adm-field__label">Название</span>
        <input class="adm-field__input" type="text" name="title" required maxlength="400"
               placeholder="Например: Серебро 999 пробы, мерные слитки">
      </label>

      <label class="adm-field adm-add__num">
        <span class="adm-field__label">Единица</span>
        <input class="adm-field__input" type="text" name="unit" maxlength="24" placeholder="1 кг">
      </label>

      <label class="adm-field adm-add__num">
        <span class="adm-field__label">Цена</span>
        <input class="adm-field__input" type="text" name="price" maxlength="60" placeholder="договорная">
      </label>

      <% if (group.columns && group.columns[1]) { %>
        <label class="adm-field adm-add__num">
          <span class="adm-field__label"><%= group.columns[1] %></span>
          <input class="adm-field__input" type="text" name="priceBulk" maxlength="60" placeholder="необязательно">
        </label>
      <% } %>

      <label class="adm-field adm-add__note">
        <span class="adm-field__label">Уточнение</span>
        <input class="adm-field__input" type="text" name="note" maxlength="400"
               placeholder="требования к позиции">
      </label>

      <div class="adm-add__submit">
        <button class="adm-btn adm-btn--accent" type="submit">Добавить</button>
      </div>
    </form>
  </section>

  <section class="adm-add">
    <h2 class="adm-add__title">Добавить категорию</h2>
    <form class="adm-add__form adm-add__form--one"
          action="/admin/catalog/<%= catalogName %>/category/add" method="post">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="group" value="<%= group.id %>">

      <label class="adm-field adm-add__title-field">
        <span class="adm-field__label">Название категории</span>
        <input class="adm-field__input" type="text" name="name" required maxlength="120"
               placeholder="Например: Конденсаторы">
      </label>

      <div class="adm-add__submit">
        <button class="adm-btn adm-btn--accent" type="submit">Добавить</button>
      </div>
    </form>
    <p class="adm-add__hint">
      Встанет в конец группы «<%= group.title %>». Дальше её можно поднять
      стрелками в заголовке, там же переименовать и удалить.
    </p>
  </section>
</main>

<%- include('_foot') %>
