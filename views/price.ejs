<%- include('partials/head') %>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<main id="main" class="price-page">

  <section class="page-head">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Прайс-лист</span>
      </nav>

      <h1 class="page-head__title">Цены на приём металлолома в Омске</h1>
      <p class="page-head__lead">
        Прайс-лист пункта приёма «Вторресурс» на 2-й Барнаульской, 105:
        <%= prices.groups.reduce(function (a, g) { return a + g.categories.reduce(function (b, c) { return b + c.items.length; }, 0); }, 0) %>
        позиций чёрного, цветного и редкоземельного лома. Чёрный металл считаем за тонну, остальной за килограмм.
        Цены действуют на <%= f.dateLong(prices.updatedAt) %>.
      </p>

      <div class="page-head__meta">
        <span class="badge badge--live">Обновлено <%= f.dateLong(prices.updatedAt) %></span>
        <span class="badge">Перевод на карту</span>
        <span class="badge">Приём <%= site.terms.minWeight %></span>
        <a class="btn btn--accent btn--sm" href="#zayavka-form">Уточнить цену</a>
      </div>
    </div>
  </section>

  <div class="price-toolbar">
    <div class="container price-toolbar__inner">
      <div class="price-tabs">
        <% prices.groups.forEach(function (g) { %>
          <a class="price-tabs__link" href="#<%= g.id %>"><%= g.title %></a>
        <% }); %>
      </div>
    </div>
  </div>

  <% prices.groups.forEach(function (group, gi) { %>
    <section class="section section--<%= gi % 2 === 0 ? 'muted' : 'light' %> price-group"
             id="<%= group.id %>" data-price-group>
      <div class="container">
        <header class="section__head">
          <p class="section__eyebrow">Прайс-лист · <%= group.unit %></p>
          <h2 class="section__title">Цены на <%= group.title.toLowerCase() %> <%= group.unitShort === "т" ? "за тонну" : "за кг" %></h2>
          <p class="section__lead"><%= group.description %></p>
        </header>

        <% if (group.categories.length > 1) { %>
          <nav class="anchors" aria-label="Разделы цен: <%= group.title %>">
            <% group.categories.forEach(function (c) { %>
              <a class="anchors__link" href="#<%= c.id %>"><%= c.name %></a>
            <% }); %>
          </nav>
        <% } %>

        <% group.categories.forEach(function (category) { %>
          <div class="price-cat" id="<%= category.id %>" data-price-cat>
            <h3 class="price-cat__title"><%= category.name %></h3>
            <div class="table-wrap">
              <table class="price-table">
                <caption class="visually-hidden"><%= category.name %> — цена приёма, ₽ <%= group.unit.replace("₽/", "за ") %></caption>
                <thead>
                  <tr>
                    <th scope="col">Позиция</th>
                    <% group.columns.forEach(function (col) { %>
                      <th scope="col" class="price-table__col"><%= col %></th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody>
                  <% category.items.forEach(function (item) { %>
                    <tr data-price-row data-search="<%= (item.title + ' ' + item.note + ' ' + category.name).toLowerCase() %>">
                      <th scope="row" class="price-table__name">
                        <%= item.title %>
                        <% if (item.note) { %><span class="price-table__note"><%= item.note %></span><% } %>
                      </th>
                      <td class="price-table__value"><b><%= f.itemPrice(item) %></b></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% }); %>

  <section class="section section--dark" id="zayavka-form">
    <div class="container price-cta">
      <div class="price-cta__text">
        <h2 class="section__title">Уточните цену перед приездом</h2>
        <p><%= prices.note %></p>
        <p>
          Для партий от 500 кг и для юридических лиц условия обсуждаются отдельно,
          как правило цена получается выше базовой. Приём ведётся на площадке в Омске
          по адресу ул. 2-я Барнаульская, 105. Звоните:
          <% site.phones.forEach(function (p, i) { %><a class="link" href="tel:<%= p.raw %>"><%= p.display %></a><%= i < site.phones.length - 1 ? ', ' : '' %><% }); %>.
        </p>
      </div>
      <div class="price-cta__form">
        <% if (leadStatus === 'ok') { %>
          <div class="alert alert--ok" role="status"><strong>Заявка принята.</strong> Скоро перезвоним.</div>
        <% } %>
        <%- include('partials/lead-form', {
          variant: 'dark',
          formTitle: 'Уточнить цену',
          formText: 'Оставьте номер. Перезвоним и назовём цену по вашей позиции.'
        }) %>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container container--narrow">
      <h2 class="section__title">От чего зависит цена приёма металлолома</h2>
      <div class="prose">
        <p>
          Стоимость приёма зависит от четырёх вещей: вида металла, его чистоты и засора,
          объёма партии и формы расчёта. Разделанный медный «блеск» стоит заметно дороже
          медной стружки, а габаритный стальной лом 3А дороже тонкого лома 12А.
          Поэтому у одного металла бывает несколько строк с разной ценой.
        </p>
        <p>
          Засором считается всё, что металлом не является: краска, изоляция, пластик, резина,
          бетон, земля и влага. Его процент определяет приёмщик при осмотре, и в оплачиваемый
          вес он не входит. Отсюда простое правило: чем чище и лучше разделан лом, тем выше
          итоговая сумма за килограмм.
        </p>
        <p>
          Разделывать самому необязательно. Кабель в изоляции, электродвигатели, радиаторы,
          АКПП и ДВС в сборе, аккумуляторы принимаются как есть, для них есть отдельные
          позиции с ценой за содержание металла.
        </p>
        <p>
          Цены в прайс-листе справочные и меняются вслед за биржевыми котировками.
          Окончательную стоимость приёмщик называет на площадке после осмотра и взвешивания.
          Если планируете сдать крупную партию, позвоните в день приезда и уточните цену.
          <a href="/#faq">Остальные частые вопросы</a> и
          <a href="/#punkt-priema">условия приёма</a> описаны на главной странице.
        </p>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
