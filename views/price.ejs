<%- include('partials/head') %>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<%#
  Прайс собран по образцу конкурента (74vtormet.ru/price), на который
  ориентируется заказчик: слева сплошной нумерованный список позиций
  с поиском наверху, справа липкий список категорий. Группы (чёрный,
  цветной, редкоземельный) на странице не показываются — в данных они
  остались, там их правят в админке и оттуда берётся OfferCatalog,
  а порядок категорий задаётся в админке кнопками «выше/ниже».
%>

<main id="main" class="price-page">

  <section class="page-head page-head--tight">
    <div class="container">
      <h1 class="page-head__title">Цены на приём металлолома в Омске</h1>
    </div>
  </section>

  <div class="container">
    <div class="price-layout">

      <div class="price-main">
        <div class="price-bar">
          <label class="price-search">
            <svg aria-hidden="true"><use href="#i-search"></use></svg>
            <input class="price-search__input" type="search" placeholder="Название лома"
                   autocomplete="off" aria-label="Поиск по прайсу" data-price-search>
          </label>
          <span class="badge badge--live">Обновлено <%= f.dateLong(prices.updatedAt) %></span>
        </div>

        <p class="price-empty" hidden data-price-empty>
          Такой позиции в прайсе нет. Позвоните, посчитаем по телефону:
          <% site.phones.forEach(function (p, i) { %><a class="link" href="tel:<%= p.raw %>"><%= p.display %></a><%= i < site.phones.length - 1 ? ' или ' : '.' %><% }); %>
        </p>

        <%# Нумерация сквозная и считается счётчиком CSS, а не в шаблоне:
            при поиске скрытые строки выпадают из счёта сами. %>
        <% categories.forEach(function (row) { %>
          <section class="price-cat" id="<%= row.category.id %>" data-price-cat>
            <h2 class="price-cat__title">
              <%= row.category.name %>
              <span class="price-cat__unit"><%= row.group.unit %></span>
            </h2>

            <table class="price-table price-table--flat">
              <caption class="visually-hidden">
                <%= row.category.name %> — цена приёма, ₽ <%= row.group.unit.replace('₽/', 'за ') %>
              </caption>
              <tbody>
                <% row.category.items.forEach(function (item) { %>
                  <tr data-price-row data-search="<%= (item.title + ' ' + (item.note || '') + ' ' + row.category.name).toLowerCase() %>">
                    <td class="price-table__num" aria-hidden="true"></td>
                    <th scope="row" class="price-table__name">
                      <%# Описание раскрывается по клику: <details> работает без JS,
                          открывается с клавиатуры и остаётся в разметке для поиска. %>
                      <% if (item.note) { %>
                        <details class="price-note">
                          <summary><%= item.title %></summary>
                          <p><%= item.note %></p>
                        </details>
                      <% } else { %>
                        <%= item.title %>
                      <% } %>
                    </th>
                    <td class="price-table__value"><b><%= f.itemPrice(item) %></b></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </section>
        <% }); %>
      </div>

      <aside class="price-nav" aria-label="Категории прайса">
        <p class="price-nav__title">Категории</p>
        <div class="price-nav__list">
          <% categories.forEach(function (row) { %>
            <a class="price-nav__link" href="#<%= row.category.id %>"
               data-nav-for="<%= row.category.id %>"><%= row.category.name %></a>
          <% }); %>
        </div>
      </aside>

    </div>
  </div>

  <section class="section section--dark" id="zayavka-form">
    <div class="container price-cta">
      <div class="price-cta__text">
        <h2 class="section__title">Уточните цену перед приездом</h2>
        <p><%= prices.note %></p>
        <p>
          Для партий от 500 кг и для юридических лиц условия обсуждаются отдельно,
          как правило цена получается выше базовой. Приём ведётся на площадке в Омске
          по адресу ул. 2-я Барнаульская, 105. Звоните:
          <% site.phones.forEach(function (p, i) { %><a class="link" href="tel:<%= p.raw %>"><%= p.display %></a><%= i < site.phones.length - 1 ? ', ' : '' %><% }); %>.
        </p>
      </div>
      <div class="price-cta__form">
        <% if (leadStatus === 'ok') { %>
          <div class="alert alert--ok" role="status"><strong>Заявка принята.</strong> Скоро перезвоним.</div>
        <% } %>
        <%- include('partials/lead-form', {
          variant: 'dark',
          formTitle: 'Уточнить цену',
          formText: 'Оставьте номер. Перезвоним и назовём цену по вашей позиции.'
        }) %>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container container--narrow">
      <h2 class="section__title">От чего зависит цена приёма металлолома</h2>
      <div class="prose">
        <ul class="prose__list">
          <% prices.groups.forEach(function (g) { %>
            <li><b><%= g.title %>, <%= g.unit %>.</b> <%= g.description %></li>
          <% }); %>
        </ul>
        <p>
          Стоимость приёма зависит от четырёх вещей: вида металла, его чистоты и засора,
          объёма партии и формы расчёта. Разделанный медный «блеск» стоит заметно дороже
          медной стружки, а габаритный стальной лом 3А дороже тонкого лома 12А.
          Поэтому у одного металла бывает несколько строк с разной ценой.
        </p>
        <p>
          Засором считается всё, что металлом не является: краска, изоляция, пластик, резина,
          бетон, земля и влага. Его процент определяет приёмщик при осмотре, и в оплачиваемый
          вес он не входит. Отсюда простое правило: чем чище и лучше разделан лом, тем выше
          итоговая сумма за килограмм.
        </p>
        <p>
          Разделывать самому необязательно. Кабель в изоляции, электродвигатели, радиаторы,
          АКПП и ДВС в сборе, аккумуляторы принимаются как есть, для них есть отдельные
          позиции с ценой за содержание металла.
        </p>
        <p>
          Цены в прайс-листе справочные и меняются вслед за биржевыми котировками.
          Окончательную стоимость приёмщик называет на площадке после осмотра и взвешивания.
          Если планируете сдать крупную партию, позвоните в день приезда и уточните цену.
          Порядок приёмки, документы и разбор засора описаны в разделе
          <a href="/kak-sdat">как сдать металлолом</a>, адрес площадки и режим работы —
          на <a href="/#punkt-priema">главной странице</a>.
        </p>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
