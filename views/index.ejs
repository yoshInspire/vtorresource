<%- include('partials/head') %>
<%- include('partials/icons') %>
<%- include('partials/header') %>

<%#
  Главная намеренно короткая. Заказчик просил убрать всё, что читают редко:
  порядок работы, блок про засор, FAQ, благодарности, документы и текстовый
  блок для организаций. Осталось то, ради чего заходят: цены, калькулятор,
  что принимаем, адрес и телефон. Тексты сведены к одной строке на блок.
%>

<main id="main">

  <!-- ================= ПЕРВЫЙ ЭКРАН ================= -->
  <%#
    Формы на первом экране больше нет: заявку принимает блок контактов внизу,
    туда же ведут кнопка в шапке и кнопка из калькулятора. Лента фактов
    (от 1 кг, 10 минут, режим, число позиций) убрана вместе с ней.
    Между оффером и кнопками стоит бегущая строка цен: раньше она шла
    отдельной полосой под первым экраном.
  %>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <%- include('partials/photo', {
        slug: 'yard-hero',
        alt: '',
        sizes: '100vw',
        eager: true,
        width: 1920, height: 1275
      }) %>
    </div>

    <div class="container">
      <div class="hero__inner">
        <p class="hero__eyebrow"><%= content.hero.eyebrow %></p>
        <h1 class="hero__title"><%= content.hero.title %></h1>
        <p class="hero__offer"><%= content.hero.offer %></p>

        <div class="ticker ticker--hero">
          <div class="ticker__inner">
            <div class="ticker__label">
              <span>Цены на</span>
              <b><%= f.dateLong(prices.updatedAt) %></b>
            </div>
            <div class="ticker__viewport">
              <div class="ticker__track">
                <% for (var pass = 0; pass < 2; pass++) { %>
                  <% ticker.forEach(function (t) { %>
                    <a class="ticker__item" href="<%= t.anchor %>"<%= pass === 1 ? ' aria-hidden="true" tabindex="-1"' : '' %>>
                      <span class="ticker__name"><%= t.label %></span>
                      <span class="ticker__price num"><%= t.price %></span>
                      <span class="ticker__unit"><%= t.unit %></span>
                    </a>
                  <% }); %>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="hero__actions">
          <a class="btn btn--accent" href="/price">Прайс-лист</a>
          <a class="btn btn--ghost" href="#kalkulyator">Калькулятор</a>
        </div>

        <div class="hero__phones">
          <% site.phones.forEach(function (p) { %>
            <span class="hero__phone-row">
              <a class="hero__phone" href="tel:<%= p.raw %>"><%= p.display %></a>
              <%- include('partials/messengers', { phone: p, size: 'md' }) %>
            </span>
          <% }); %>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= КАЛЬКУЛЯТОР ================= -->
  <section class="section section--muted" id="kalkulyator">
    <div class="container">
      <header class="section__head">
        <h2 class="section__title">Сколько вы получите</h2>
      </header>

      <script type="application/json" id="calc-data"><%- calcItemsJson %></script>

      <div class="calc" data-calc>
        <div class="calc__form">
          <%#
            Не выпадающий список из десятка ходовых позиций, а поиск по всему
            прайсу: человек начинает вводить, и в подсказках остаётся то,
            что подходит. Пока поле пустое, сверху стоят ходовые позиции.
            Разметку списка строит main.js, здесь только поле и пустой listbox.
          %>
          <div class="field calc__pick" data-calc-pick>
            <label class="field__label" for="calc-item">Что сдаёте</label>
            <input class="field__input" id="calc-item" type="text"
                   role="combobox" aria-expanded="false" aria-controls="calc-item-list"
                   aria-autocomplete="list" autocomplete="off" spellcheck="false"
                   placeholder="Начните вводить: медь, алюминий, аккумулятор"
                   data-calc-input>
            <ul class="calc__options" id="calc-item-list" role="listbox"
                aria-label="Позиции прайса" hidden data-calc-list></ul>
          </div>

          <div class="calc__row">
            <label class="field">
              <span class="field__label">Вес</span>
              <input class="field__input" type="number" inputmode="decimal" min="0" step="0.1"
                     value="10" data-calc-weight>
            </label>
            <label class="field">
              <span class="field__label">Единица</span>
              <select class="field__input" data-calc-unit>
                <option value="kg" selected>кг</option>
                <option value="t">тонн</option>
              </select>
            </label>
          </div>

          <noscript>
            <p class="calc__noscript">
              Калькулятор работает с включённым JavaScript. Без него посмотрите
              <a class="link" href="/price">прайс-лист</a> или позвоните нам.
            </p>
          </noscript>

        </div>

        <div class="calc__result">
          <p class="calc__result-label">Ориентировочно к выплате</p>
          <p class="calc__sum num" data-calc-sum>—</p>
          <p class="calc__disclaimer">
            Расчёт справочный. Точную сумму приёмщик называет после осмотра и взвешивания.
          </p>
          <a class="btn btn--accent btn--block calc__cta" href="#zayavka-form">Уточнить по телефону</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ЧТО ПРИНИМАЕМ ================= -->
  <section class="section section--light" id="priem">
    <div class="container">
      <header class="section__head section__head--split">
        <h2 class="section__title">Что принимаем</h2>
        <a class="btn btn--ghost btn--sm" href="/price">Прайс-лист</a>
      </header>

      <div class="tiles">
        <% tiles.forEach(function (t) { %>
          <a class="tile<%= t.photo ? '' : ' tile--flat' %><%= t.wide ? ' tile--wide' : '' %>" href="<%= t.anchor %>">
            <% if (t.photo) { %>
              <span class="tile__media" aria-hidden="true">
                <%- include('partials/photo', {
                  slug: t.photo, alt: '',
                  sizes: '(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw',
                  width: 1280, height: 960
                }) %>
              </span>
            <% } %>
            <span class="tile__name"><%= t.name %></span>
            <span class="tile__price">
              <span class="tile__price-value num">
                <% if (t.from) { %>до <%= f.price(t.from) %><small><%= t.unit %></small><% } else { %>цена по запросу<% } %>
              </span>
              <span class="tile__more">прайс-лист</span>
            </span>
          </a>
        <% }); %>
      </div>

      <div class="chips">
        <% content.alsoAccepted.forEach(function (a) { %>
          <a class="chip" href="<%= a.anchor %>"><%= a.name %></a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= ПЛОЩАДКА ================= -->
  <section class="section section--muted" id="punkt-priema">
    <div class="container">
      <header class="section__head">
        <h2 class="section__title"><%= content.location.title %></h2>
      </header>

      <div class="map">
        <!-- Карта грузится по клику: iframe Яндекса ставит свои куки, а в
             политике обработки ПД заявлено, что трекинговых кук на сайте нет.
             До клика показываем статичную заглушку с адресом. -->
        <div class="map__frame map__placeholder" data-map data-map-src="<%= mapEmbed %>"
             data-map-title="Карта: <%= site.address.full %>">
          <svg class="map__pin" aria-hidden="true"><use href="#i-pin"></use></svg>
          <p class="map__placeholder-addr"><%= site.address.full %></p>
          <p class="map__placeholder-note">Карту загружает Яндекс со своими cookie, поэтому включаем её по клику.</p>
          <button class="btn btn--accent btn--sm" type="button" data-map-load>Показать карту</button>
        </div>
        <div class="map__bar">
          <div>
            <p class="map__addr"><%= site.address.full %></p>
            <p class="map__hint"><%= site.hours.text %></p>
          </div>

          <%# Рейтинг стоит здесь, а не отдельной секцией: оценку смотрят
              вместе с адресом, и на строку она укладывается целиком. %>
          <a class="map__rating" href="<%= site.profiles.twogis %>" target="_blank" rel="noopener">
            <span class="map__rating-value num"><%= reviews.score.toLocaleString('ru-RU') %></span>
            <span class="map__rating-stars" aria-hidden="true">★★★★★</span>
            <span class="map__rating-count"><%= reviews.countLabel %></span>
          </a>

          <a class="btn btn--dark btn--sm" href="<%= site.mapUrl %>" target="_blank" rel="noopener">
            Построить маршрут
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= ДОКУМЕНТЫ И БЛАГОДАРНОСТИ ================= -->
  <section class="section section--light" id="dokumenty">
    <div class="container">
      <div class="papers">
        <div class="papers__facts">
          <h2 class="section__title"><%= content.documents.title %></h2>
          <dl class="papers__list">
            <% content.documents.rows.forEach(function (r) { %>
              <div class="papers__row">
                <dt><%= r.k %></dt>
                <dd><%= r.v %></dd>
              </div>
            <% }); %>
          </dl>
        </div>

        <div class="papers__shots">
          <% content.documents.gratitude.forEach(function (g) { %>
            <figure class="papers__shot">
              <a href="/img/docs/<%= g.slug %>-900.jpg" target="_blank" rel="noopener">
                <picture>
                  <source type="image/webp"
                          srcset="/img/docs/<%= g.slug %>-420.webp 420w, /img/docs/<%= g.slug %>-900.webp 900w"
                          sizes="(max-width: 720px) 45vw, 200px">
                  <img src="/img/docs/<%= g.slug %>-420.jpg"
                       srcset="/img/docs/<%= g.slug %>-420.jpg 420w, /img/docs/<%= g.slug %>-900.jpg 900w"
                       sizes="(max-width: 720px) 45vw, 200px"
                       width="420" height="560" loading="lazy" decoding="async"
                       alt="<%= g.alt %>">
                </picture>
              </a>
              <figcaption><%= g.caption %></figcaption>
            </figure>
          <% }); %>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= КОНТАКТЫ ================= -->
  <section class="section cta" id="kontakty">
    <div class="cta__media" aria-hidden="true">
      <%- include('partials/photo', {
        slug: 'chermet',
        alt: '',
        sizes: '100vw',
        width: 1920, height: 1440
      }) %>
    </div>

    <div class="container cta__inner">
      <div>
        <h2 class="section__title">Привозите, посчитаем при вас</h2>
        <div class="cta__phones">
          <% site.phones.forEach(function (p) { %>
            <span class="cta__phone-row">
              <a class="cta__phone" href="tel:<%= p.raw %>"><%= p.display %></a>
              <%- include('partials/messengers', { phone: p, size: 'md' }) %>
            </span>
          <% }); %>
        </div>
        <div class="cta__meta">
          <p><strong>Адрес:</strong> <%= site.address.full %></p>
          <p><strong>Режим:</strong> <%= site.hours.text %></p>
          <p><strong>Организациям:</strong> договор, безнал, полный пакет документов</p>
          <p><strong>Почта:</strong> <a class="link" href="mailto:<%= site.email %>"><%= site.email %></a></p>
        </div>
      </div>

      <div class="cta__form" id="zayavka-form">
        <% if (leadStatus === 'ok') { %>
          <div class="alert alert--ok" role="status">
            <strong>Заявка принята.</strong> Перезвоним в рабочее время.
          </div>
        <% } else if (leadStatus === 'error') { %>
          <div class="alert alert--err" role="alert">
            Не удалось отправить заявку. Проверьте номер или позвоните напрямую.
          </div>
        <% } %>
        <%- include('partials/lead-form', {
          variant: 'dark',
          formTitle: 'Узнать цену',
          formText: 'Скажите, что везёте. Перезвоним и назовём цену.'
        }) %>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
